# CareerLens — environment variables
# Copy this file to .env and fill in your values.
# .env is git-ignored — never commit real credentials.

# ─── Backend ──────────────────────────────────────────────────────────────────

# MongoDB connection string.
# Local:  mongodb://localhost:27017
# Atlas:  mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
# IMPORTANT: must be MONGODB_URI (not MONGO_URI) — this is what database.py reads.
MONGODB_URI=mongodb://localhost:27017

# Name of the MongoDB database to use.
DATABASE_NAME=careerlens

# LLM API keys (optional — the app falls back to mock without them)
GEMINI_API_KEY=
GROQ_API_KEY=

# Extra CORS origins beyond localhost and the default Render URL (comma-separated).
# Only needed if you deploy the frontend to a custom domain.
ALLOWED_ORIGINS=

# ─── Frontend (careerlens-ui) ─────────────────────────────────────────────────

# URL of the FastAPI backend. Required when deploying to Render (or any host
# where frontend and backend are separate services).
# In development this is not needed — next.config.js defaults to http://127.0.0.1:8000
#
# Set this in the Render dashboard → Frontend service → Environment tab.
# Example: BACKEND_API_URL=https://careerlens-api.onrender.com
BACKEND_API_URL=
