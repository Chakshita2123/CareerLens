# CareerLens UI — Environment Variables (.env.local)

# ─── NextAuth.js Configuration ───────────────────────────────────────────────
# In local development: http://localhost:3000
# In production on Render: https://careerlens-1-y5zn.onrender.com
NEXTAUTH_URL=http://localhost:3000

# A strong random secret used to hash tokens and sign session cookies.
# Generate in terminal: openssl rand -base64 32
NEXTAUTH_SECRET=your_generated_random_secret_here

# ─── Google OAuth 2.0 Credentials ─────────────────────────────────────────────
# Obtained from Google Cloud Console → APIs & Services → Credentials
# Authorized redirect URI must match: <NEXTAUTH_URL>/api/auth/callback/google
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret

# ─── Backend API Proxy ────────────────────────────────────────────────────────
# In development, next.config.js proxies to http://127.0.0.1:8000 by default.
# In production on Render, set this to your backend service URL:
# BACKEND_API_URL=https://careerlens-d3vi.onrender.com
BACKEND_API_URL=
